  <script>
    let currentFontSize = 16;

    function increaseFont() {
      currentFontSize += 2;
      document.body.style.fontSize = currentFontSize + "px";
    }

    function decreaseFont() {
      currentFontSize -= 2;

      if (currentFontSize < 12) {
        currentFontSize = 12;
      }

      document.body.style.fontSize = currentFontSize + "px";
    }

    function toggleDarkMode() {
      document.body.classList.toggle("dark-mode");

      // remove contrast if active
      document.body.classList.remove("high-contrast");
    }

    function toggleContrast() {
      document.body.classList.toggle("high-contrast");

      // remove dark mode if active
      document.body.classList.remove("dark-mode");
    }

    function resetAccessibility() {
      currentFontSize = 16;

      document.body.style.fontSize = "16px";
      document.body.classList.remove("dark-mode");
      document.body.classList.remove("high-contrast");
    }
  </script>
<script>

const websiteData = [

{
    title:"Home Page",
    link:"nhm.gov.in",
    content:"The National Health Policy, 2017 envisages- the attainment of the highest possible level of health and wellbeing for all at all ages, through a preventive and promotive health"
},

{
    title:"About Us",
    link:"https://nhm.gov.in/index4.php?lang=1&level=0&linkid=456&lid=685",
    content:"We develop government healthcare portals, webinar systems, and educational platforms."
},

{
    title:"Services",
    link:"services.html",
    content:"Our services include website development, webinar hosting, AI tools, and PHP projects."
},

{
    title:"Contact Us",
    link:"contact.html",
    content:"Contact us for MCA final year projects, healthcare website development and software support."
},

{
    title:"Medical Webinar",
    link:"webinar.html",
    content:"Join live medical webinars, online doctor training sessions and healthcare education programs."
}

]; 

function highlightText(text, keyword){

    let regex = new RegExp(keyword, "gi");

    return text.replace(regex, function(match){
        return "<mark>" + match + "</mark>";
    });

}

function searchContent(){

    let keyword = document.getElementById("searchInput").value.trim().toLowerCase();

    let resultsDiv = document.getElementById("results");

    let resultInfo = document.getElementById("resultInfo");

    resultsDiv.innerHTML = "";

    if(keyword === ""){

        resultInfo.innerHTML = "Please enter search keyword";
        return;

    }

    let found = 0;

    websiteData.forEach(function(page){

        if(
            page.title.toLowerCase().includes(keyword) ||
            page.content.toLowerCase().includes(keyword)
        ){

            found++;

            resultsDiv.innerHTML += `

            <div class="result-item">

                <h3>
                    <a href="${page.link}">
                        ${highlightText(page.title, keyword)}
                    </a>
                </h3>

                <p>
                    ${highlightText(page.content, keyword)}
                </p>

            </div>

            `;

        }

    });

    resultInfo.innerHTML = found + " result(s) found";

    if(found === 0){

        resultsDiv.innerHTML = `
            <div class="no-result">
                No matching result found
            </div>
        `;

    }

}

document.getElementById("searchInput")
.addEventListener("keypress", function(event){

    if(event.key === "Enter"){
        searchContent();
    }

});

</script>		<!--//header-top-->

